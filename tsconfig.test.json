{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "outDir": "./test-build",
        "rootDir": "."
    },
    "include": [
        "tests/**/*.ts",
        "target/types/**/*.ts"
    ]
}